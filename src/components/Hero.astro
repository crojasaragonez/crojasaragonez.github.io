---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow hero-animate">Co-Founder & Chief AI Officer · Subaxa</p>
    <h1 class="name hero-animate">{site.name}</h1>
    <p class="title hero-animate">{site.title}</p>
    <p class="tagline hero-animate">{site.tagline}</p>
    <div class="btn-row hero-animate">
      <a class="btn btn-primary" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
        Connect on LinkedIn
      </a>
      <a class="btn btn-secondary" href={`${base}#speaking`}>View talks</a>
      <a class="btn btn-secondary" href={`${base}resume.pdf`}>Download résumé</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    padding-block: clamp(3.5rem, 12vh, 7rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: auto -10% 10% 40%;
    height: 55%;
    background: radial-gradient(closest-side, rgba(47, 219, 154, 0.16), transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 52rem;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .name {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 12ch;
    background: linear-gradient(120deg, #f3fff8 20%, var(--accent) 140%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .title {
    margin: 1.1rem 0 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 600;
  }

  .title::after {
    content: '';
    display: block;
    width: 0;
    height: 2px;
    margin-top: 0.85rem;
    background: linear-gradient(90deg, var(--accent), transparent);
    animation: underline 1.1s var(--ease) 0.55s forwards;
  }

  .tagline {
    margin: 1.4rem 0 2rem;
    max-width: 38rem;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.6;
  }

  .hero-animate {
    opacity: 0;
    transform: translateY(1.1rem);
    animation: rise 0.85s var(--ease) forwards;
  }

  .hero-animate:nth-child(1) {
    animation-delay: 0.05s;
  }
  .hero-animate:nth-child(2) {
    animation-delay: 0.15s;
  }
  .hero-animate:nth-child(3) {
    animation-delay: 0.25s;
  }
  .hero-animate:nth-child(4) {
    animation-delay: 0.35s;
  }
  .hero-animate:nth-child(5) {
    animation-delay: 0.45s;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes underline {
    to {
      width: 7rem;
    }
  }
</style>
