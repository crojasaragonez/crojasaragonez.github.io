---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const portrait = `${base}carlos.jpg`;
---

<section class="hero">
  <div class="hero-media">
    <img
      class="hero-photo hero-animate"
      src={portrait}
      alt={site.name}
      width="1200"
      height="1600"
      fetchpriority="high"
    />
  </div>
  <div class="container hero-inner">
    <p class="eyebrow hero-animate">Co-Founder & Chief AI Officer · Subaxa</p>
    <h1 class="name hero-animate">{site.name}</h1>
    <p class="title hero-animate">{site.title}</p>
    <p class="tagline hero-animate">{site.tagline}</p>
    <div class="btn-row hero-animate">
      <a class="btn btn-primary" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
        Connect on LinkedIn
      </a>
      <a class="btn btn-secondary" href={`${base}#speaking`}>View talks</a>
      <a class="btn btn-secondary" href={`${base}resume.pdf`}>Download résumé</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(7, 12, 9, 0.35) 0%, rgba(7, 12, 9, 0.72) 45%, rgba(7, 12, 9, 0.96) 100%),
      linear-gradient(90deg, rgba(7, 12, 9, 0.88) 0%, rgba(7, 12, 9, 0.45) 55%, rgba(10, 61, 40, 0.25) 100%);
    pointer-events: none;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    padding-block: clamp(3.5rem, 12vh, 7rem);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .name {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 12ch;
    background: linear-gradient(120deg, #f3fff8 20%, var(--accent) 140%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .title {
    margin: 1.1rem 0 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 600;
  }

  .title::after {
    content: '';
    display: block;
    width: 0;
    height: 2px;
    margin-top: 0.85rem;
    background: linear-gradient(90deg, var(--accent), transparent);
    animation: underline 1.1s var(--ease) 0.55s forwards;
  }

  .tagline {
    margin: 1.4rem 0 2rem;
    max-width: 34rem;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.6;
  }

  .hero-animate {
    opacity: 0;
    transform: translateY(1.1rem);
    animation: rise 0.85s var(--ease) forwards;
  }

  .hero-media .hero-animate {
    animation-name: fade-scale;
    animation-duration: 1.1s;
    transform: scale(1.04);
  }

  .hero-inner .hero-animate:nth-child(1) {
    animation-delay: 0.12s;
  }
  .hero-inner .hero-animate:nth-child(2) {
    animation-delay: 0.22s;
  }
  .hero-inner .hero-animate:nth-child(3) {
    animation-delay: 0.32s;
  }
  .hero-inner .hero-animate:nth-child(4) {
    animation-delay: 0.42s;
  }
  .hero-inner .hero-animate:nth-child(5) {
    animation-delay: 0.52s;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-scale {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes underline {
    to {
      width: 7rem;
    }
  }

  @media (min-width: 960px) {
    .hero {
      align-items: center;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }

    .hero-media {
      inset: 0 0 0 42%;
    }

    .hero-media::after {
      background:
        linear-gradient(90deg, var(--bg) 0%, rgba(7, 12, 9, 0.72) 18%, rgba(7, 12, 9, 0.2) 48%, transparent 70%),
        linear-gradient(180deg, rgba(7, 12, 9, 0.25) 0%, transparent 30%, rgba(7, 12, 9, 0.35) 100%),
        radial-gradient(ellipse 60% 50% at 70% 40%, rgba(47, 219, 154, 0.12), transparent 60%);
    }

    .hero-photo {
      object-position: center 15%;
    }

    .hero-inner {
      grid-column: 1;
      padding-block: clamp(4rem, 10vh, 7rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media .hero-animate {
      transform: none;
    }
  }
</style>
