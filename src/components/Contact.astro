---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="section contact" id="contact">
  <div class="container reveal">
    <p class="section-label">Contact</p>
    <h2 class="section-title">Let’s talk</h2>
    <p class="section-lead">
      For speaking invitations, founder conversations, or executive opportunities, reach me on LinkedIn.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
        Message on LinkedIn
      </a>
      <a class="btn btn-secondary" href={site.socials.github} target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      <a class="btn btn-secondary" href={`${base}resume.pdf`}>Download résumé</a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(5rem, 12vw, 8rem);
  }

  .btn-row {
    margin-top: 1.75rem;
  }
</style>
