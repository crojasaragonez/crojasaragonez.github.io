---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="section" id="about">
  <div class="container reveal">
    <p class="section-label">About</p>
    <h2 class="section-title">{site.about.lead}</h2>
    <p class="section-lead">{site.about.summary}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={`${base}about/`}>Read my trajectory</a>
      <a class="btn btn-secondary" href={`${base}ventures/`}>Ventures</a>
    </div>
  </div>
</section>

<style>
  .btn-row {
    margin-top: 1.75rem;
  }
</style>
