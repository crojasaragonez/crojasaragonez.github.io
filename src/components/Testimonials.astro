---
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
}

const { testimonials } = Astro.props;
---

<section class="section" id="testimonials">
  <div class="container">
    <div class="reveal">
      <p class="section-label">Testimonials</p>
      <h2 class="section-title">What partners say</h2>
    </div>
    <ul class="quotes reveal">
      {
        testimonials.map((item) => (
          <li>
            <blockquote>“{item.data.quote}”</blockquote>
            <p class="byline">
              <span class="name">{item.data.name}</span>
              <span>
                {item.data.role}
                {item.data.company ? ` · ${item.data.company}` : ''}
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .quotes {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .quotes li {
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--border-strong);
  }

  blockquote {
    margin: 0 0 1rem;
    color: var(--text);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.55;
    font-weight: 500;
  }

  .byline {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    font-size: 0.92rem;
  }

  .name {
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    .quotes li {
      padding: 0;
      border-top: 0;
      border-left: 1px solid var(--border-strong);
      padding-left: 1.5rem;
    }

    .quotes li:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
