---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="section" id="ventures">
  <div class="container">
    <div class="intro reveal">
      <div>
        <p class="section-label">Ventures</p>
        <h2 class="section-title">Companies I’ve co-founded</h2>
        <p class="section-lead">
          Golabs, the nearshore company I built and later took to a majority sale, and Subaxa, the AI-native
          proptech company I’m building now.
        </p>
      </div>
      <a class="btn btn-secondary" href={`${base}ventures/`}>View ventures</a>
    </div>
    <ul class="ventures reveal">
      {
        site.ventures.map((venture) => (
          <li>
            <div class="meta">
              <span class="period">{venture.period}</span>
              <span>{venture.role}</span>
            </div>
            <h3>
              <a href={`${base}ventures/${venture.slug}/`}>{venture.name}</a>
            </h3>
            <p>{venture.tagline}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .ventures {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .ventures li {
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--border);
  }

  .ventures li:first-child {
    border-top: 1px solid var(--border);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.4rem;
    color: var(--accent-soft);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .period {
    color: var(--secondary);
  }

  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .ventures p {
    margin: 0;
    max-width: 46rem;
  }

  @media (min-width: 800px) {
    .ventures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 2rem;
    }

    .ventures li:nth-child(1),
    .ventures li:nth-child(2) {
      border-top: 1px solid var(--border);
    }
  }
</style>
