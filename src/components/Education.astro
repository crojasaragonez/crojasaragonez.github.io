---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;

const mitPhotos = [
  {
    src: 'mit_2.jpeg',
    alt: 'Carlos Rojas at Killian Court in front of the MIT Great Dome',
    caption: 'On campus at MIT, Killian Court.',
  },
  {
    src: 'mit_1.jpeg',
    alt: 'MIT Professional Education badge for Carlos Luis Rojas Aragonés, CTO at Golabs',
    caption: 'MIT Professional Education, Chief Technology Officer program.',
  },
];
---

<section class="section" id="education">
  <div class="container">
    <div class="intro reveal">
      <p class="section-label">Education</p>
      <h2 class="section-title">Credentials & teaching</h2>
      <p class="section-lead">
        The MIT CTO Executive Program is a defining chapter right now: sharpening how I lead technology strategy,
        AI, and organizations at the level the work demands.
      </p>
    </div>

    <div class="mit-gallery reveal">
      {
        mitPhotos.map((photo) => (
          <figure>
            <img
              src={`${base}${photo.src}`}
              alt={photo.alt}
              width="800"
              height="1066"
              loading="lazy"
            />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    <ul class="list reveal">
      {
        site.education.map((item) => (
          <li>
            <div>
              <h3>{item.school}</h3>
              <p>{item.program}</p>
            </div>
            <span class="year">{item.year}</span>
          </li>
        ))
      }
    </ul>
    <p class="teaching reveal">{site.teaching}</p>
  </div>
</section>

<style>
  .mit-gallery {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .mit-gallery figure {
    margin: 0;
  }

  .mit-gallery img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
  }

  .mit-gallery figcaption {
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .list {
    list-style: none;
    margin: 2.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .list li {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  h3 {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
  }

  .list p {
    margin: 0;
  }

  .year {
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .teaching {
    margin-top: 1.75rem;
    max-width: 42rem;
  }

  @media (min-width: 700px) {
    .mit-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
    }

    .list li {
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 1.5rem;
    }
  }
</style>
