---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL;
const formatter = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title="Blog"
  description="Notes on AI-native companies, engineering leadership, and technology strategy from Carlos Luis Rojas Aragonés."
>
  <section class="section">
    <div class="container">
      <p class="section-label">Blog</p>
      <h1 class="page-title">Notes on technology & leadership</h1>
      {
        posts.length === 0 ? (
          <p class="empty">New posts coming soon.</p>
        ) : (
          <ul class="posts">
            {posts.map((post) => (
              <li>
                <a href={`${base}blog/${post.id}/`}>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatter.format(post.data.pubDate)}
                  </time>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    max-width: 16ch;
    margin-bottom: 2rem;
  }

  .empty {
    margin: 0;
    max-width: 36rem;
    color: var(--text-muted);
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts a {
    display: block;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .posts li:last-child a {
    border-bottom: 1px solid var(--border);
  }

  .posts a:hover h2 {
    color: var(--accent);
  }

  time {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--accent-soft);
    font-size: 0.9rem;
    font-weight: 500;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.45rem;
    transition: color 0.2s var(--ease);
  }

  .posts p {
    margin: 0;
    max-width: 46rem;
  }
</style>
