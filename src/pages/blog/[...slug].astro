---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const formatter = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="section">
    <div class="container article">
      <a class="back" href={`${base}blog/`}>← All posts</a>
      <header>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatter.format(post.data.pubDate)}
        </time>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.description}</p>
      </header>
      <div class="content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 44rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .back:hover {
    color: var(--accent);
  }

  time {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--accent-soft);
    font-size: 0.9rem;
    font-weight: 500;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 0.85rem;
  }

  .dek {
    font-size: 1.15rem;
    margin-bottom: 2.5rem;
  }

  .content :global(h2) {
    margin: 2.25rem 0 0.85rem;
    font-size: 1.4rem;
  }

  .content :global(p),
  .content :global(li) {
    color: var(--text-muted);
  }

  /* Opening paragraph carries the reader in, so give it more presence */
  .content > :global(p:first-of-type) {
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--text);
  }

  .content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  /* Pull quotes for the standalone one-line beats */
  .content :global(blockquote) {
    margin: 2.5rem 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--accent);
  }

  .content :global(blockquote p) {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  /* Screenshots break the full column width to stand apart from the prose */
  .content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 2.5rem 0 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* An all-italic paragraph right after an image is its caption */
  .content :global(p:has(img)) {
    margin: 0;
  }

  .content :global(p:has(img) + p:has(em:only-child)) {
    margin: 0 0 2.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .content :global(p:has(img) + p:has(em:only-child) em) {
    font-style: normal;
  }

  /* Inline SVG diagrams: they scroll rather than shrink their labels away */
  .content :global(figure.fig) {
    margin: 2.5rem 0;
    overflow-x: auto;
  }

  .content :global(figure.fig svg) {
    display: block;
    width: 100%;
    min-width: 28rem;
    height: auto;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(21, 27, 45, 0.55);
    font-family: var(--font-display);
  }

  .content :global(figure.fig figcaption) {
    margin-top: 0.85rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .content :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .content :global(ul) {
    padding-left: 1.2rem;
    margin: 0 0 1.25rem;
  }

  /* Numbered lists get accent badges instead of plain markers */
  .content :global(ol) {
    list-style: none;
    counter-reset: item;
    padding-left: 0;
    margin: 0 0 1.25rem;
  }

  .content :global(ol > li) {
    counter-increment: item;
    position: relative;
    padding-left: 2.75rem;
  }

  .content :global(ol > li::before) {
    content: counter(item);
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.65rem;
    height: 1.65rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--accent-soft);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .content :global(li + li) {
    margin-top: 0.7rem;
  }

  .content :global(a) {
    color: var(--accent);
  }
</style>
