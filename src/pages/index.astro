---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Impact from '../components/Impact.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import Expertise from '../components/Expertise.astro';
import SpeakingTeaser from '../components/SpeakingTeaser.astro';
import Testimonials from '../components/Testimonials.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Contact from '../components/Contact.astro';

const talks = (await getCollection('talks'))
  .filter((talk) => talk.data.featured)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 5);

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Hero />
  <Impact />
  <AboutTeaser />
  <Expertise />
  <SpeakingTeaser talks={talks} />
  <Testimonials testimonials={testimonials} />
  <BlogTeaser posts={posts} />
  <Contact />
</BaseLayout>
