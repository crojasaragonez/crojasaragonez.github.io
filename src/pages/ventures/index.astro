---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Ventures"
  description={`Companies co-founded by ${site.name} — Golabs and Subaxa.`}
>
  <section class="section intro">
    <div class="container reveal">
      <p class="section-label">Ventures</p>
      <h1 class="page-title">Companies I’ve co-founded</h1>
      <div class="copy">
        <p>
          Two chapters of building: first a nearshore engineering company grown from a small team in San Carlos,
          then an AI-native product company designed around intelligence from day one.
        </p>
      </div>
    </div>
  </section>

  <section class="section catalog">
    <div class="container">
      <ul class="ventures reveal">
        {
          site.ventures.map((venture) => (
            <li>
              <div class="meta">
                <span class="period">{venture.period}</span>
                <span>{venture.role}</span>
              </div>
              <h2>
                <a href={`${base}ventures/${venture.slug}/`}>{venture.name}</a>
              </h2>
              <p class="tagline">{venture.tagline}</p>
              <p>{venture.summary}</p>
              <a class="more" href={`${base}ventures/${venture.slug}/`}>
                Read the story
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section cta">
    <div class="container reveal">
      <h2 class="section-title">Want the full trajectory?</h2>
      <p class="section-lead">Roles, education, and leadership highlights live on the about page.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={`${base}about/`}>
          About me
        </a>
        <a class="btn btn-secondary" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(3rem, 8vw, 5rem);
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    max-width: 14ch;
    margin-bottom: 1.75rem;
  }

  .copy {
    max-width: 46rem;
  }

  .copy p {
    margin: 0;
    font-size: 1.05rem;
  }

  .ventures {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .ventures li {
    padding: 2rem 0;
    border-top: 1px solid var(--border);
  }

  .ventures li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.45rem;
    color: var(--accent-soft);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .period {
    color: var(--secondary);
  }

  h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  .tagline {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-weight: 500;
  }

  .ventures p {
    margin: 0;
    max-width: 46rem;
  }

  .more {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
  }

  .more:hover {
    color: var(--accent-soft);
  }

  .cta {
    padding-bottom: clamp(5rem, 12vw, 8rem);
  }
</style>
